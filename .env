# ===============================
# Frontend Environment Variables
# ===============================
# This file contains environment variables for local development.
# IMPORTANT: Do NOT commit this file to source control. Add .env to .gitignore.

# Backend API base URL (existing)
VITE_API_URL=https://stacksapp-backend.onrender.com

# -------------------------------
# Cloudinary export (one-time)
# -------------------------------
# These variables are used only by the one-time exporter script:
#   tools/export_cloudinary_assets.js
# The exporter runs locally (node) and reads these values via dotenv.
# Do NOT prefix API_SECRET with VITE_ — that would expose it to the browser.
CLOUDINARY_CLOUD_NAME=dycytqdfj
CLOUDINARY_API_KEY=983286743251596
CLOUDINARY_API_SECRET=zeU4nedVzVzvqqndh2MF82AdRiI

# Output path for the exported JSON (relative to project root)
# The default React/Vite public folder is "public/". The script writes the file here.
OUT_FILE=public/cloudinary-assets.json

# -------------------------------
# Notes
# -------------------------------
# 1) Fill in CLOUDINARY_API_KEY and CLOUDINARY_API_SECRET with values from
#    your Cloudinary dashboard before running the exporter.
# 2) Run the exporter from your project root:
#      npm install cloudinary dotenv
#      node tools/export_cloudinary_assets.js
# 3) After the script finishes, start your frontend dev server and confirm:
#      http://localhost:3000/cloudinary-assets.json
#
# Remember: keep this .env local and do not commit secrets to your repo.
